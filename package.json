{
  "name": "@rascaltwo/pairwise-sorter",
  "version": "0.1.0",
  "description": "Rank anything by answering \"which is better?\" one pair at a time — a logic core and web components.",
  "license": "MIT",
  "type": "module",
  "repository": "github:RascalTwo/pairwise-sorter",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "default": "./dist/element/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/element/index.js"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs": "typedoc",
    "docs:dev": "tsc -p tsconfig.build.json --outDir viz-pages/docs/dist",
    "docs:publish": "node scripts/publish-docs.ts",
    "site": "npm run compile && npm run docs && cp -R pages/. site/ && cp -R dist site/dist",
    "check": "run-s --continue-on-error clean typecheck test coverage",
    "clean": "node -e \"fs.rmSync('out', { recursive: true, force: true })\"",
    "coverage": "r2-test-kit merge"
  },
  "devDependencies": {
    "@rascaltwo/r2-test-kit": "file:../ai-setup/tools/r2-test-kit",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^24.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "npm-run-all2": "9.0.4",
    "puppeteer-core": "^25.12.0",
    "typedoc": "^0.28.20",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
